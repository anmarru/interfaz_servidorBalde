<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="485.0" prefWidth="1065.0" spacing="20.0" stylesheets="@../estilo/estilo.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="andrea.crud_concesionario.CocheController">

    <Label style="-fx-font-size: 18px;" text="Gestión de Coches" />

    <TableView fx:id="tablaCoches" prefHeight="377.0" prefWidth="812.0">
        <columns>
            <TableColumn fx:id="colId" text="ID" />
            <TableColumn fx:id="colMatricula" text="Matrícula" />
            <TableColumn fx:id="colMarca" text="Marca" />
            <TableColumn fx:id="colModelo" text="Modelo" />
            <TableColumn fx:id="colFecha" text="Fecha" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox prefHeight="41.0" prefWidth="889.0" spacing="8.0">
      <TextField fx:id="txtid" layoutX="20.0" layoutY="10.0" promptText="Id" />
        <TextField fx:id="txtMatricula" promptText="Matrícula" />
        <TextField fx:id="txtMarca" promptText="Marca" />
        <TextField fx:id="txtModelo" promptText="Modelo" />
        <TextField fx:id="txtFecha" promptText="Fecha (YYYY-MM-DD)" />
        <Button fx:id="btnAgregar" onAction="#save" text="Agregar" />
        <Button fx:id="btnActualizar" onAction="#update" text="Actualizar" />
        <Button fx:id="btnEliminar" onAction="#delete" text="Eliminar" />
      <Button fx:id="btnBuscarMatricula" layoutX="844.0" layoutY="10.0" onAction="#findByMatricula" text="Buscar matrícula" />
      <Button fx:id="btnVolver" layoutX="901.0" layoutY="10.0" onAction="#cargarCoches" text="Todos" />
      <padding>
         <Insets left="10.0" />
      </padding>
    </HBox>
</VBox>
